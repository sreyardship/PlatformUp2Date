# The native binary is built in the Nix devshell, so its ELF interpreter and
# RUNPATH point into /nix/store paths that don't exist in the runtime image.
# Patch the interpreter to the standard glibc loader and drop the Nix RUNPATH
# so the loader resolves libc/libpthread/librt/libdl from the micro image's
# /lib64. The binary requires GLIBC_2.34, so the runtime base must be UBI9
# (glibc 2.34) — quarkus-micro-image:2.0 is UBI8 (glibc 2.28) and is too old.
#
# The loader path depends on the target architecture (docs/adr/0043). patchelf
# only rewrites ELF headers, so this stage runs on the build platform and
# never needs emulation; the binary itself must already be compiled for the
# target. BUILDPLATFORM/TARGETARCH are BuildKit's automatic platform args.
FROM --platform=$BUILDPLATFORM alpine:3 AS patcher
ARG TARGETARCH
RUN apk add --no-cache patchelf
WORKDIR /work/
COPY build-native/*-runner /work/application
RUN case "$TARGETARCH" in \
        amd64) loader=/lib64/ld-linux-x86-64.so.2 ;; \
        arm64) loader=/lib/ld-linux-aarch64.so.1 ;; \
        *) echo "unsupported target architecture: ${TARGETARCH:-unset (BuildKit required)}; supported: amd64, arm64" >&2; exit 1 ;; \
    esac \
    && patchelf \
        --set-interpreter "$loader" \
        --remove-rpath \
        /work/application

# The native binary is linked against libz.so.1 (zlib), which the ubi-micro
# runtime image does not ship — without it the app dies at startup with
# "libz.so.1: cannot open shared object file". zlib is part of the full UBI9
# base image, so grab just that library and drop it into /lib64 where the
# patched loader resolves libc et al.
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS libz

FROM registry.access.redhat.com/ubi9/ubi-micro:9.8
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --from=libz /usr/lib64/libz.so.1* /lib64/
COPY --from=patcher --chown=1001:root /work/application /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
